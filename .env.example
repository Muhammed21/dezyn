# Copier en .env pour le développement local. Valeurs factices, locales uniquement.
# Les mots de passe PG_PASSWORD_* sont lus par db-init ; ils doivent correspondre aux DATABASE_URL_*.

# PostgreSQL : superutilisateur du conteneur, jamais utilisé par les applications
POSTGRES_PASSWORD=dev_postgres
POSTGRES_PORT=5432

# Base de l'application et mots de passe de ses rôles
PG_DATABASE=dezyn
PG_PASSWORD_MIGRATOR=dev_migrator
PG_PASSWORD_APP=dev_app
PG_PASSWORD_HISTORY_MAINTAINER=dev_history_maintainer

# Connexions : migrator applique les migrations, app sert l'application, history_maintainer purge l'historique
# secretlint-disable -- identifiants factices, locaux à 127.0.0.1
DATABASE_URL_MIGRATOR=postgresql://migrator:dev_migrator@127.0.0.1:5432/dezyn
DATABASE_URL=postgresql://app:dev_app@127.0.0.1:5432/dezyn
DATABASE_URL_HISTORY_MAINTAINER=postgresql://history_maintainer:dev_history_maintainer@127.0.0.1:5432/dezyn
# secretlint-enable

# Authentification (better-auth) : secret de signature, 32 caractères au moins, et URL publique de l'API
# secretlint-disable -- valeur factice, locale uniquement
BETTER_AUTH_SECRET=dev-secret-dezyn-local-32-caracteres-min
# secretlint-enable
BETTER_AUTH_URL=http://127.0.0.1:3000
# En-tête qui porte l'IP du client, posé par le proxy de confiance (limite de débit de better-auth, ADR 0033)
TRUSTED_IP_HEADER=cf-connecting-ip

# Stockage objet compatible S3 (SeaweedFS en local) : images de snapshots (ADR 0005)
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=dezyn-local
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key

# Emails capturés par Mailpit en local : invitations et alertes de stockage (ADR 0006)
MAILPIT_SMTP_PORT=1025
MAIL_FROM="dezyn <no-reply@dezyn.test>"

# URL publique du front web : liens des invitations
WEB_URL=http://127.0.0.1:5173
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

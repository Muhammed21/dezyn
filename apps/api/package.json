{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#platform/*": "./src/platform/*",
    "#testing/*": "./src/testing/*",
    "#modules/*": "./src/modules/*",
    "#db": "./src/platform/postgres-database.ts",
    "#create-app": "./src/create-app.ts",
    "#compose-modules": "./src/compose-modules.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts --outputJson bench-results.json",
    "check-types": "tsc --noEmit",
    "mutation": "stryker run",
    "seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=../../.env scripts/reset.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@repo/auth-verifier": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/result": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  }
}

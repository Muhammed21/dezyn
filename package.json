{
  "name": "dezyn",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "turbo run generate",
    "migrate": "pnpm --filter @repo/db migrate",
    "studio": "pnpm --filter @repo/db studio",
    "lint": "oxlint --type-aware .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "bench": "turbo run bench",
    "secrets": "secretlint \"**/*\"",
    "infra:up": "./docker/up.sh",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && ./docker/up.sh",
    "test:infra": "./docker/tests/infra.test.sh",
    "prepare": "husky",
    "seed": "pnpm --filter @repo/api seed",
    "db:reset": "pnpm --filter @repo/api db:reset",
    "preview:github": "./scripts/env/preview-github.sh",
    "preview:db": "./scripts/env/preview-db.sh",
    "preview:clean": "./scripts/env/preview-clean.sh",
    "roles:replace": "./scripts/env/roles-replace.sh",
    "prod:check": "./scripts/env/prod-check.sh",
    "prod:github": "./scripts/env/prod-github.sh",
    "prod:secrets": "./scripts/env/prod-secrets.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "secretlint": "^13.0.7",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "secretlint",
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": "oxfmt --write --no-error-on-unmatched-pattern",
    "*.{ts,tsx,js,jsx,mjs,cjs}": "oxlint",
    "docs/**/*.md": "sh -c 'pnpm --filter @repo/docs-catalog generate && git add docs/CATALOG.md' --"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0"
}

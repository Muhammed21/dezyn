{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/throwaway-database.ts"
  },
  "scripts": {
    "generate": "node scripts/latest-migration.ts",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "studio": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check-types": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
